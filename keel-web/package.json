{
  "name": "keel-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start --port 5173",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:api": "openapi-typescript docs/api/keel-openapi.yaml -o lib/api/schema.d.ts",
    "smoke:api": "node scripts/smoke-api.mts",
    "check:contract": "node scripts/check-contract.mts",
    "check:no-float-math": "node scripts/check-no-float-math.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:contract && pnpm check:no-float-math",
    "check:contract-upstream": "node scripts/check-contract-upstream.mts",
    "mock": "prism mock docs/api/keel-openapi.yaml -p 4010",
    "check:mock-states": "node scripts/check-mock-states.mts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.4",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT"
}
