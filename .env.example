# Where the Keel engine is served from. The dashboard at /dashboard reads every figure
# from it; nothing is recomputed in the browser and nothing is hardcoded.
#
# Reads are made from the server, so the API's CORS allowlist does not gate this app
# and the dev server may run on any port.
#
# Live API. Read-only, no key, no auth:
NEXT_PUBLIC_KEEL_API_URL=https://api.keels.app/v1
#
# Contract mock (Prism, static mode), for the display states that live data cannot
# reach. Start it with:
#   npx @stoplight/prism-cli mock public/evidence/keel-openapi.yaml -p 4010
# NEXT_PUBLIC_KEEL_API_URL=http://localhost:4010

# The deployed origin. Used for the social card's absolute URLs. Wrong or unset, shared
# previews point at the wrong place.
# NEXT_PUBLIC_SITE_URL=https://keels.app

# NEXT_PUBLIC_DASHBOARD_URL is gone. The dashboard was a second application on a second
# host and this named where it lived; it is now mounted in this one at /dashboard, so
# there is nothing to point at and no fallback to configure.
